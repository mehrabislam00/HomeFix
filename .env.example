# Local development defaults; replace placeholders with your own service values.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

MONGODB_URI=mongodb://localhost:27017/HomeFix_DB
MONGODB_USERNAME=replace-me
MONGODB_PASSWORD=replace-me

# Configure both Google credentials to enable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

STRIPE_SECRET_KEY=replace-me
HOMEFIX_PAYMENT_API_SECRET=replace-me
